FROM python:3.12-slim
WORKDIR /app
COPY hunters/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && playwright install --with-deps --only-shell chromium
COPY hunters /app/hunters
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
CMD ["python", "-m", "hunters.main", "all", "--once", "--timeout", "180", "--report", "/reports/hunters.json"]
